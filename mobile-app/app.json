{
  "expo": {
    "name": "IoT Nexus",
    "slug": "iot-nexus",
    "scheme": "iotnexus",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#050914"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.iotnexus.app",
      "adaptiveIcon": {
        "backgroundColor": "#050914"
      }
    },
    "plugins": [
      "expo-router",
      "react-native-reanimated"
    ],
    "extra": {}
  }
}